# Your watsonx Orchestrate API key (keep secret, never commit the real value)
ORCHESTRATE_API_KEY=

# Base URL of your Orchestrate instance, e.g. https://api.us-south.assistant.watson.cloud.ibm.com
ORCHESTRATE_BASE_URL=

# The agent ID as shown in the Orchestrate console
AGENT_ID=

# Port the proxy listens on locally (Render injects its own PORT automatically)
PORT=3000
